rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || (!isSignedIn() && isValidId(userId));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document for boot verification
    match /test/{docId} {
      allow read: if true;
    }

    // User profile document and subcollections
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // Cycle history and tracking
      match /cycles/{cycleId} {
        allow read, write: if isValidId(userId) && isOwner(userId);

        // Nested log entries under cycle
        match /logEntries/{entryId} {
          allow read, write: if isValidId(userId) && isOwner(userId);
        }
      }

      // Direct log entries / daily logs
      match /logEntries/{entryId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
      match /dailyLogs/{date} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Cycle Settings
      match /cycleSettings/{settingId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Personalized algorithmic & AI cycle insights
      match /insights/{insightId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Cycle & wellness reminders
      match /reminders/{reminderId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Partner permissions
      match /partnerPermissions/{permId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Subscriptions & payments
      match /payments/{paymentId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Membership status
      match /membership/{memberId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Gemini AI Chat History
      match /chatHistory/{chatId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // Saved Affirmations & Favorites
      match /affirmations/{affId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
    }

    // Community Forum Posts
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
