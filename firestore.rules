rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // User cycle settings
      match /cycleSettings/{settingId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // User daily logs
      match /dailyLogs/{date} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }

      // User partner permissions
      match /partnerPermissions/{permId} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
    }

    // Community Forum Posts
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
