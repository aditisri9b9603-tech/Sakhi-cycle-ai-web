{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Sakhi Cycle including birth date and health goals",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "birthDate": { "type": "string" },
        "healthGoals": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "premium_status": { "type": "string" },
        "membershipPlan": { "type": "string" },
        "premium_activated_at": { "type": "string" }
      },
      "required": ["email", "displayName"]
    },
    "Cycle": {
      "title": "Cycle",
      "description": "Menstrual cycle record with start date, end date, and duration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "cycleLength": { "type": "number" },
        "periodDuration": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["startDate"]
    },
    "LogEntry": {
      "title": "LogEntry",
      "description": "Daily symptoms, flow intensity, mood, and notes for cycle tracking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cycleId": { "type": "string" },
        "entryDate": { "type": "string" },
        "mood": { "type": "string" },
        "flowIntensity": { "type": "string" },
        "notes": { "type": "string" },
        "physicalSymptoms": { "type": "string" },
        "energy": { "type": "number" },
        "sleepHours": { "type": "number" },
        "waterGlasses": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["entryDate", "mood", "flowIntensity"]
    },
    "Insight": {
      "title": "Insight",
      "description": "Algorithmic and AI wellness insights generated for user's cycle",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "content"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Cycle and wellness notifications and alerts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reminderType": { "type": "string" },
        "reminderDate": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["reminderType", "reminderDate"]
    },
    "CycleSettings": {
      "title": "CycleSettings",
      "description": "Menstrual cycle length, duration, and rhythm preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lastPeriodDate": { "type": "string" },
        "cycleLength": { "type": "number" },
        "periodDuration": { "type": "number" },
        "lutealLength": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "lastPeriodDate", "cycleLength", "periodDuration"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily symptoms, flow, mood, sleep, and hydration logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "mood": { "type": "string" },
        "energy": { "type": "number" },
        "flow": { "type": "string" },
        "symptoms": { "type": "array" },
        "sleepHours": { "type": "number" },
        "waterGlasses": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date"]
    },
    "PartnerPermissions": {
      "title": "PartnerPermissions",
      "description": "Granular sharing controls for partner care",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isLinked": { "type": "boolean" },
        "partnerName": { "type": "string" },
        "inviteCode": { "type": "string" },
        "sharePhase": { "type": "boolean" },
        "shareNextPeriod": { "type": "boolean" },
        "sharePMSMood": { "type": "boolean" },
        "shareDailyLogs": { "type": "boolean" },
        "shareSymptoms": { "type": "boolean" },
        "sharePrivateNotes": { "type": "boolean" }
      },
      "required": ["userId", "inviteCode"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Anonymous community discussions with reactions and comments",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "authorPseudonym": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["authorUid", "title", "content", "category"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Verified subscription payments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentId": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "orderId", "paymentId", "planId", "amount", "status"]
    },
    "MembershipRecord": {
      "title": "MembershipRecord",
      "description": "Active premium membership state for user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "planId": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "activatedAt": { "type": "string" },
        "lastPaymentId": { "type": "string" },
        "lastOrderId": { "type": "string" }
      },
      "required": ["userId", "planId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/membership/{memberId}": {
      "schema": { "$ref": "#/entities/MembershipRecord" },
      "description": "User membership tier and status"
    },
    "/users/{userId}/cycles/{cycleId}": {
      "schema": { "$ref": "#/entities/Cycle" },
      "description": "User cycle records"
    },
    "/users/{userId}/cycles/{cycleId}/logEntries/{logEntryId}": {
      "schema": { "$ref": "#/entities/LogEntry" },
      "description": "Cycle-specific daily log entries"
    },
    "/users/{userId}/logEntries/{logEntryId}": {
      "schema": { "$ref": "#/entities/LogEntry" },
      "description": "User daily log entries"
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": { "$ref": "#/entities/Insight" },
      "description": "Cycle wellness and AI health insights"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "Cycle reminders and notifications"
    },
    "/users/{userId}/cycleSettings/current": {
      "schema": { "$ref": "#/entities/CycleSettings" },
      "description": "Current cycle settings for user"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": { "$ref": "#/entities/DailyLog" },
      "description": "Daily cycle check-in for specific date"
    },
    "/users/{userId}/partnerPermissions/current": {
      "schema": { "$ref": "#/entities/PartnerPermissions" },
      "description": "Partner permissions for user"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "User payment transactions"
    },
    "/forumPosts/{postId}": {
      "schema": { "$ref": "#/entities/ForumPost" },
      "description": "Community forum discussions"
    }
  }
}
